{
  "name": "@kongyo2/beastlocator-cli",
  "version": "1.0.1",
  "description": "Interactive BeastLocator CLI migrated from the Android app",
  "type": "module",
  "bin": {
    "beastlocator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx src/cli.tsx",
    "build": "npm run clean && tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs",
    "start": "node ./dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --silent",
    "lint:strict": "oxlint --deny-warnings",
    "check:file": "oxlint",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm run test && npm run build"
  },
  "keywords": [
    "cli",
    "ink",
    "react",
    "beastlocator",
    "terminal"
  ],
  "author": "kongyo2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongyo2/beastlocator-cli.git"
  },
  "homepage": "https://github.com/kongyo2/beastlocator-cli#readme",
  "bugs": {
    "url": "https://github.com/kongyo2/beastlocator-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^7.0.0",
    "ink-picture": "^1.3.5",
    "neverthrow": "^8.2.0",
    "play-sound": "^1.1.6",
    "react": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/play-sound": "^1.1.2",
    "@types/react": "^19.2.14",
    "oxlint": "^1.60.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
